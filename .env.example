# Copia este archivo como .env y rellena tus datos.
# .env está en .gitignore, así que tus credenciales no se suben a Git.

# Credenciales de Realm VTT. Las usan los scripts y el CLI
# (node src/cli.js ...), así que no te las pide cada vez.
REALM_EMAIL=
REALM_PASSWORD=

# Opcional: ID de la campaña. Si lo dejas vacío, test-api.js lista tus
# campañas y te pide elegir una.
REALM_CAMPAIGN_ID=
